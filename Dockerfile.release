FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    jq \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# GoReleaser pre-builds the binary and places it at $TARGETPLATFORM/rapidforge in the build context
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/rapidforge .

ARG PORT=8080
ENV RF_PORT=:${PORT}
EXPOSE ${PORT}

CMD ["./rapidforge"]
